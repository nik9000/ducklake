# name: test/sql/transaction/snapshot_isolation_delete_snapshot_filter.test
# description: A pinned AT read must not see deletes committed after the pinned snapshot, even when the transaction holds a local delete on the same file
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/snapshot_isolation_delete_snapshot_filter', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.foo(i VARCHAR);

statement ok
INSERT INTO ducklake.foo VALUES ('a'), ('b'), ('c'), ('d');

statement ok
DELETE FROM ducklake.foo WHERE i = 'a';

# pin the snapshot after the first delete but before the second
statement ok
SET VARIABLE snap = (SELECT max(snapshot_id) FROM ducklake.snapshots())

statement ok
SET VARIABLE ts = (SELECT snapshot_time FROM ducklake.snapshots() WHERE snapshot_id = getvariable('snap'))

statement ok
DELETE FROM ducklake.foo WHERE i = 'b';

# control - outside any transaction the pinned read only reflects the first delete
query I
SELECT * FROM ducklake.foo AT (VERSION => getvariable('snap')) ORDER BY i
----
b
c
d

statement ok
BEGIN

# a local delete on the same data file must not disturb the pinned read
statement ok
DELETE FROM ducklake.foo WHERE i = 'c';

query I
SELECT * FROM ducklake.foo AT (VERSION => getvariable('snap')) ORDER BY i
----
b
c
d

query I
SELECT * FROM ducklake.foo AT (TIMESTAMP => getvariable('ts')) ORDER BY i
----
b
c
d

statement ok
COMMIT

query I
SELECT * FROM ducklake.foo ORDER BY i
----
d
