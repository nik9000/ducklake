# name: test/sql/transaction/snapshot_isolation_delete_inlined.test
# description: A pinned AT read must not see an uncommitted local DELETE of inlined data
# group: [transaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/snapshot_isolation_delete_inlined', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE ducklake.foo(i VARCHAR);

statement ok
INSERT INTO ducklake.foo VALUES ('deleted'), ('kept');

# pin the snapshot taken before the transaction makes any local changes
statement ok
SET VARIABLE snap = (SELECT max(snapshot_id) FROM ducklake.snapshots())

statement ok
SET VARIABLE ts = (SELECT snapshot_time FROM ducklake.snapshots() WHERE snapshot_id = getvariable('snap'))

statement ok
BEGIN

statement ok
DELETE FROM ducklake.foo WHERE i = 'deleted';

# an AT clause bypasses the transaction's own local uncommitted changes
query I
SELECT * FROM ducklake.foo AT (VERSION => getvariable('snap')) ORDER BY i
----
deleted
kept

# ... and the same holds when the snapshot is pinned by timestamp
query I
SELECT * FROM ducklake.foo AT (TIMESTAMP => getvariable('ts')) ORDER BY i
----
deleted
kept

statement ok
COMMIT

# even after the commit, the pinned read still only sees the original snapshot
query I
SELECT * FROM ducklake.foo AT (VERSION => getvariable('snap')) ORDER BY i
----
deleted
kept

# the latest data reflects the change
query I
SELECT * FROM ducklake.foo ORDER BY i
----
kept
